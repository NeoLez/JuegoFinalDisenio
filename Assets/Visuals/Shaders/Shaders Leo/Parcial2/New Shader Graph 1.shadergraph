{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "c0fcb40f0fd14e25b4d3c9d4e160c99f",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Loop (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -479.0,
            "y": -30.0,
            "width": 208.0,

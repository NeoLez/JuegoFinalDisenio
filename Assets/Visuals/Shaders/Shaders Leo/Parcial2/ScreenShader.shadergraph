    "m_SourceType": 1,
    "m_FunctionName": "Loop",
    "m_FunctionSource": "88bd669cace94a6a2acffdd842ff14ed",
    "m_FunctionBody": "Bindings_SampleLight_d3670751bc62b909da89d7b36eaef0da_float Bindings;\nfloat nothing;\n\nfloat distanceTravelled = noise;\nlightAmount = 1;\nwhile(distanceTravelled < distanceLimit) {\n    float c;\n    SG_SampleLight_d3670751bc62b909da89d7b36eaef0da_float(stepSize, density, startWorldPos, noiseTexture, noiseScale, Bindings, c, nothing);\n    lightAmount *= exp(-c);\n    distanceTravelled += stepSize;\n    startWorldPos += viewDirection * stepSize;\n}\nlightAmount = 1 - lightAmount;"
}


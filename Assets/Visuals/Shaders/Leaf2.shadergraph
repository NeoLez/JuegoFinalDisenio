{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "85ef810d4cd8407a91cea6313f269f5e",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "MainLight (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1203.58203125,
            "y": 192.71644592285157,
            "width": 224.9552001953125,
            "height": 141.13438415527345
        }
    },
    "m_Slots": [
        {
            "m_Id": "0663524b1f164d7a8207bb1812d88272"
        },
        {
            "m_Id": "abee225dd62e4f17880a4f982a297dfe"
        },
        {
            "m_Id": "78007c72c4fe4fe69cddf2e44ad44acf"
        },
        {
            "m_Id": "27b6aa4d93ca4311b830e0e16b3bff06"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "MainLight",
    "m_FunctionSource": "",
    "m_FunctionBody": "#if SHADERGRAPH_PREVIEW\r\r\n    Color = 1;\r\r\n    ShadowAtten = 1;\n    Direction = float3(0.5, 0.5, 0);\r\n#else\r\n#if SHADOWS_SCREEN\r\n    float4 clipPos = TransformWorldToHClip(WorldPos);\r\n    float4 shadowCoord = ComputeScreenPos(clipPos);\r\n#else\r\n    float4 shadowCoord = TransformWorldToShadowCoord(WorldPos);\r\n#endif\r\n    Light mainLight = GetMainLight(shadowCoord);\r\r\n    Direction = mainLight.direction;\n    Color = mainLight.color;\r\r\n    ShadowSamplingData shadowSamplingData = GetMainLightShadowSamplingData();\r\n    float shadowStrength = GetMainLightShadowStrength();\r\n    ShadowAtten = SampleShadowmap(shadowCoord, TEXTURE2D_ARGS(_MainLightShadowmapTexture, sampler_MainLightShadowmapTexture), shadowSamplingData, shadowStrength, false); \r\n#endif"
}

